# ==============================================================================
# GS SOWMIYA BUILDERS — LOCAL / PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

APP_ENV=local
APP_DEBUG=true
APP_URL=https://gssowmiyabuilders.com
TIMEZONE=Asia/Kolkata

# MySQL Database (XAMPP default / Production)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_CHARSET=utf8mb4

# SMTP Credentials (Hostinger Email)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USERNAME=info@gssowmiyabuilders.com
# Enter your Hostinger mailbox password below
SMTP_PASSWORD=
SMTP_ENCRYPTION=tls
MAIL_FROM=no-reply@gssowmiyabuilders.com
MAIL_FROM_NAME="GS Sowmiya Builders"
NO_REPLY_EMAIL=no-reply@gssowmiyabuilders.com
COMPANY_EMAIL=info@gssowmiyabuilders.com
COMPANY_NAME="GS Sowmiya Builders Pvt Ltd"

# Google reCAPTCHA v3 (Enabled with matched keys)
RECAPTCHA_ENABLED=true
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5
RECAPTCHA_EXPECTED_ACTION=submit_enquiry

# Google Sheets Integration
GOOGLE_SHEETS_ENABLED=false
GOOGLE_SHEET_ID=your-sheet-edit-id
GOOGLE_SHEET_RANGE="Leads!A:M"
GOOGLE_SERVICE_ACCOUNT_PATH=/backend/config/private/google-service-account.json

# Rate Limiting & Queue
RATE_LIMIT_MAX_HITS=5
RATE_LIMIT_WINDOW_SECONDS=600
QUEUE_MAX_ATTEMPTS=5
QUEUE_BATCH_SIZE=20
