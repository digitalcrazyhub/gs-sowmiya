# ==============================================================================
# GS SOWMIYA BUILDERS — LOCAL / PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost
TIMEZONE=Asia/Kolkata

# MySQL Database (XAMPP default)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=testmail_db
DB_USER=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# SMTP Credentials (Using Google Workspace / Gmail SMTP for digitalcrazyhub2020@gmail.com)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=digitalcrazyhub2020@gmail.com
# your_smtp_mailbox_password_here
SMTP_PASSWORD=your-mail-app-password
SMTP_ENCRYPTION=ssl
MAIL_FROM=digitalcrazyhub2020@gmail.com
MAIL_FROM_NAME="GS Sowmiya Builders"
COMPANY_EMAIL=digitalcrazyhub2020@gmail.com
COMPANY_NAME="GS Sowmiya Builders Pvt Ltd"

# Google reCAPTCHA v3 (Enabled with matched keys)
RECAPTCHA_ENABLED=true
RECAPTCHA_SITE_KEY=your-site-key
RECAPTCHA_SECRET_KEY=your-secret-key
RECAPTCHA_MIN_SCORE=0.5
RECAPTCHA_EXPECTED_ACTION=submit_enquiry

# Google Sheets Integration
GOOGLE_SHEETS_ENABLED=false
GOOGLE_SHEET_ID=your-sheet-edit-id
GOOGLE_SHEET_RANGE="Leads!A:M"
GOOGLE_SERVICE_ACCOUNT_PATH=/backend/config/private/google-service-account.json

# Rate Limiting & Queue
RATE_LIMIT_MAX_HITS=5
RATE_LIMIT_WINDOW_SECONDS=600
QUEUE_MAX_ATTEMPTS=5
QUEUE_BATCH_SIZE=20
