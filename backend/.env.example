# ==============================================================================
# GS SOWMIYA BUILDERS — BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to `/backend/.env` on your production host (e.g. Hostinger hPanel).
# NEVER commit the actual `.env` file with live credentials to version control.
# ==============================================================================

# Application Environment
APP_ENV=production
APP_DEBUG=false
APP_URL=https://gssowmiyabuilders.com
TIMEZONE=Asia/Kolkata

# MySQL Database Configuration (Hostinger MySQL Database)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=u123456789_gssowmiya_db
DB_USER=u123456789_dbuser
DB_PASSWORD=your_strong_mysql_password_here
DB_CHARSET=utf8mb4

# PHPMailer / SMTP Credentials (Hostinger Business Mail or Google Workspace SMTP)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USERNAME=no-reply@gssowmiyabuilders.com
SMTP_PASSWORD=your_smtp_mailbox_password_here
SMTP_ENCRYPTION=ssl
MAIL_FROM=no-reply@gssowmiyabuilders.com
MAIL_FROM_NAME="GS Sowmiya Builders"
COMPANY_EMAIL=md@sowmiyabuilders.com
COMPANY_NAME="GS Sowmiya Builders Private Limited"

# Google reCAPTCHA v3 Configuration
# Get keys from https://www.google.com/recaptcha/admin
RECAPTCHA_ENABLED=true
RECAPTCHA_SITE_KEY=your_recaptcha_v3_site_key_here
RECAPTCHA_SECRET_KEY=your_recaptcha_v3_secret_key_here
RECAPTCHA_MIN_SCORE=0.5
RECAPTCHA_EXPECTED_ACTION=submit_enquiry

# Google Sheets Synchronization (Optional / Secondary Integration)
# Place service account JSON in `/backend/config/private/google-service-account.json`
GOOGLE_SHEETS_ENABLED=false
GOOGLE_SHEET_ID=your_google_spreadsheet_id_here
GOOGLE_SHEET_RANGE="Leads!A:M"
GOOGLE_SERVICE_ACCOUNT_PATH=/backend/config/private/google-service-account.json

# Security & Rate Limiting (5 enquiries per 10 minutes per IP)
RATE_LIMIT_MAX_HITS=5
RATE_LIMIT_WINDOW_SECONDS=600

# Queue Worker Settings
QUEUE_MAX_ATTEMPTS=5
QUEUE_BATCH_SIZE=20
