# ==============================================================================
# GS SOWMIYA BUILDERS — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env and configure with your environment-specific credentials
# ==============================================================================

# Application Environment (production / local / staging)
APP_ENV=production
APP_DEBUG=false
APP_URL=https://gssowmiyabuilders.com
TIMEZONE=Asia/Kolkata

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=sowmiya_db
DB_USER=sowmiya_user
DB_PASSWORD=your_secure_db_password
DB_CHARSET=utf8mb4

# SMTP & PHPMailer Configuration (Hostinger / cPanel / Gmail SMTP)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USERNAME=no-reply@gssowmiyabuilders.com
SMTP_PASSWORD=your_secure_smtp_password
SMTP_ENCRYPTION=ssl
MAIL_FROM=no-reply@gssowmiyabuilders.com
MAIL_FROM_NAME="GS Sowmiya Builders"
COMPANY_EMAIL=md@sowmiyabuilders.com
COMPANY_NAME="GS Sowmiya Builders Management"

# Google reCAPTCHA v3 Protection
RECAPTCHA_ENABLED=true
RECAPTCHA_SITE_KEY=your_google_recaptcha_v3_site_key
RECAPTCHA_SECRET_KEY=your_google_recaptcha_v3_secret_key
RECAPTCHA_MIN_SCORE=0.5
RECAPTCHA_EXPECTED_ACTION=submit_enquiry

# Google Sheets Synchronization (Optional)
GOOGLE_SHEETS_ENABLED=false
GOOGLE_SHEET_ID=your_google_sheet_spreadsheet_id
GOOGLE_SHEET_RANGE=Leads!A:M
GOOGLE_SERVICE_ACCOUNT_PATH=config/private/google-service-account.json

# API Rate Limiting Policy
RATE_LIMIT_MAX_HITS=5
RATE_LIMIT_WINDOW_SECONDS=600

# Background Queue Worker Settings
QUEUE_MAX_ATTEMPTS=5
QUEUE_BATCH_SIZE=20
CRON_SECRET=your_optional_secret_for_web_cron
