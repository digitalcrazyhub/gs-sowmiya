# ==============================================================================
# GS SOWMIYA BUILDERS — ENVIRONMENT CONFIGURATION TEMPLATE
# File: /backend/.env.example
# Copy this file to /backend/.env and configure values for your environment.
# Never commit real passwords or production API secret keys to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT
# ------------------------------------------------------------------------------
# Set to 'production' on live server; 'local' for local development
APP_ENV=production

# Set to 'false' in production to disable verbose error exposure
APP_DEBUG=false

# Canonical site base URL (used for CORS and absolute links)
APP_URL=https://gssowmiyabuilders.com

# System timezone
TIMEZONE=Asia/Kolkata

# ------------------------------------------------------------------------------
# 2. MYSQL DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Local XAMPP default: DB_HOST=localhost, DB_USER=root, DB_PASSWORD=, DB_NAME=testmail_db
# Hostinger production: Use credentials created in Hostinger hPanel -> Databases
DB_HOST=localhost
DB_PORT=3306
DB_NAME=sowmiya_db
DB_USER=sowmiya_user
DB_PASSWORD=your_secure_database_password
DB_CHARSET=utf8mb4

# ------------------------------------------------------------------------------
# 3. SMTP & HOSTINGER EMAIL CONFIGURATION
# ------------------------------------------------------------------------------
# Hostinger SMTP host
SMTP_HOST=smtp.hostinger.com

# SMTP Port: 587 (recommended with TLS/STARTTLS) or 465 (SSL)
SMTP_PORT=587

# SMTP Encryption: 'tls' (for port 587) or 'ssl' (for port 465)
SMTP_ENCRYPTION=tls

# Authorized company mailbox username
SMTP_USERNAME=info@gssowmiyabuilders.com

# Authorized company mailbox password (created in Hostinger Email Manager)
SMTP_PASSWORD=your_hostinger_mailbox_password_here

# Outgoing From header (must match authorized company domain, e.g. no-reply)
MAIL_FROM=no-reply@gssowmiyabuilders.com
MAIL_FROM_NAME="GS Sowmiya Builders"
NO_REPLY_EMAIL=no-reply@gssowmiyabuilders.com

# Company recipient for new customer lead alerts
COMPANY_EMAIL=info@gssowmiyabuilders.com
COMPANY_NAME="GS Sowmiya Builders Management"

# ------------------------------------------------------------------------------
# 4. GOOGLE reCAPTCHA v3 (Spam & Bot Protection)
# ------------------------------------------------------------------------------
# Set to 'true' in production; 'false' allows bypass during offline/local testing
RECAPTCHA_ENABLED=true
RECAPTCHA_SITE_KEY=your_recaptcha_v3_site_key
RECAPTCHA_SECRET_KEY=your_recaptcha_v3_secret_key
RECAPTCHA_MIN_SCORE=0.5
RECAPTCHA_EXPECTED_ACTION=submit_enquiry

# ------------------------------------------------------------------------------
# 5. GOOGLE SHEETS SYNCHRONIZATION (Optional Secondary Integration)
# ------------------------------------------------------------------------------
GOOGLE_SHEETS_ENABLED=false
GOOGLE_SHEET_ID=your_google_sheet_spreadsheet_id
GOOGLE_SHEET_RANGE="Leads!A:M"
GOOGLE_SERVICE_ACCOUNT_PATH=config/private/google-service-account.json

# ------------------------------------------------------------------------------
# 6. RATE LIMITING & SECURITY THROTTLE
# ------------------------------------------------------------------------------
# Maximum enquiries accepted per IP within window
RATE_LIMIT_MAX_HITS=5

# Window size in seconds (600 seconds = 10 minutes)
RATE_LIMIT_WINDOW_SECONDS=600

# ------------------------------------------------------------------------------
# 7. BACKGROUND QUEUE WORKER & CRON CONFIGURATION
# ------------------------------------------------------------------------------
# Maximum batch size evaluated per cron cycle
QUEUE_BATCH_SIZE=20

# Maximum attempts before lead is marked permanently failed
QUEUE_MAX_ATTEMPTS=5

# Secret token required if triggering queue/process.php via HTTP GET (?secret=...)
CRON_SECRET=your_random_secure_cron_secret_token_here
