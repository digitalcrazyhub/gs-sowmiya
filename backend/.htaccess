# ==============================================================================
# GS SOWMIYA BUILDERS — BACKEND HTTP ACCESS & HARDENING RULES
# File: /backend/.htaccess
# ==============================================================================

Options -Indexes

# 1. Deny direct web access to sensitive files, manifests, logs, and backups
<FilesMatch "^\.|^\.env|composer\.(json|lock)$|README\.md|.*\.(sql|log|json|yml|yaml|ini|bak|swp|dist)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# 2. Strict directory routing
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Allow public contact API endpoint only
    RewriteRule ^api/contact\.php$ - [L]

    # Block direct web access to all internal directories
    RewriteRule ^(?:config|database|services|queue|logs|vendor|_backups)/ - [F,L]
</IfModule>
