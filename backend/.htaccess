# ==============================================================================
# GS SOWMIYA BUILDERS — BACKEND SECURITY CONFIGURATION (.htaccess)
# Ensures only public API endpoints can be accessed via HTTP.
# Blocks direct access to configuration, database, internal services, queue, and logs.
# ==============================================================================

# Disable directory browsing
Options -Indexes

# Prevent access to sensitive dot files and environment configs
<FilesMatch "^\.|\.env|composer\.(json|lock)|README\.md|schema\.sql|\.sql$|\.log$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Protect internal directories: config, database, services, queue, logs
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Allow direct access to the public API
    RewriteRule ^api/contact\.php$ - [L]

    # Block direct HTTP access to all internal subdirectories
    RewriteRule ^(config|database|services|queue|logs|vendor)/ - [F,L]
</IfModule>
