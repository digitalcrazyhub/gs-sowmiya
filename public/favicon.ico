<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="100%" height="100%">
  <defs>
    <linearGradient id="favBg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#7C1D24" />
      <stop offset="100%" stop-color="#4E0F16" />
    </linearGradient>
    <linearGradient id="favGold" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#FFE3A8" />
      <stop offset="40%" stop-color="#D8A95C" />
      <stop offset="80%" stop-color="#F3D089" />
      <stop offset="100%" stop-color="#A67931" />
    </linearGradient>
    <filter id="favShadow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="4" stdDeviation="4" flood-color="#000000" flood-opacity="0.45" />
    </filter>
  </defs>

  <!-- Luxury Burgundy Rounded Badge -->
  <rect width="512" height="512" rx="112" fill="url(#favBg)" />
  <rect x="16" y="16" width="480" height="480" rx="98" fill="none" stroke="url(#favGold)" stroke-width="4" opacity="0.6" />

  <!-- Centered GSB Monogram Cipher in Radiant Gold -->
  <g transform="translate(68, 52) scale(1.25)" filter="url(#favShadow)" stroke="url(#favGold)" stroke-linecap="round" stroke-linejoin="round">
    <!-- Left Pillar -->
    <path d="M128 65 L128 235" stroke-width="7" />
    <path d="M114 65 L142 65" stroke-width="5" />
    <path d="M114 235 L142 235" stroke-width="5" />

    <!-- Right Pillar -->
    <path d="M172 65 L172 235" stroke-width="7" />
    <path d="M158 65 L186 65" stroke-width="5" />
    <path d="M158 235 L186 235" stroke-width="5" />

    <!-- Classical Arch Connectors -->
    <path d="M128 82 C142 72, 158 72, 172 82" stroke-width="5" fill="none" />
    <path d="M128 218 C142 228, 158 228, 172 218" stroke-width="5" fill="none" />

    <!-- Crossbeam -->
    <path d="M112 150 L188 150" stroke-width="7" />

    <!-- Outer 'G' Wing -->
    <path d="M 150 72
             C 102 72, 60 102, 60 150
             C 60 196, 102 228, 146 228
             C 165 228, 176 220, 182 212"
          stroke-width="9" fill="none" />
    <path d="M 150 84
             C 114 84, 76 108, 76 150
             C 76 188, 114 214, 148 214"
          stroke-width="3.5" fill="none" />

    <!-- Outer 'B' Right Lobes -->
    <path d="M 150 74
             C 204 74, 238 96, 238 122
             C 238 142, 208 150, 178 150"
          stroke-width="9" fill="none" />
    <path d="M 178 150
             C 214 150, 244 162, 244 188
             C 244 216, 204 228, 148 228"
          stroke-width="9" fill="none" />

    <!-- Intertwined 'S' -->
    <path d="M 184 96
             C 165 82, 134 90, 126 108
             C 118 126, 138 140, 152 148
             C 178 160, 188 178, 182 196
             C 174 218, 134 224, 114 206"
          stroke-width="8" fill="none" />
  </g>
</svg>
